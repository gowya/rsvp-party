# Base Postgres (Neon) : créée automatiquement par `vercel integration add neon`.
# Inutile si la section rsvp est désactivée.
DATABASE_URL=

# Mot de passe de la page /admin (insensible aux majuscules)
ADMIN_PASSWORD=

# Adresse exacte (optionnelle : sans elle, seule la ville s'affiche).
# Visible après une réponse oui / peut-être, ou par tous si place.revealAddress = "always"
EVENT_ADDRESS=

# Adresse publique du site (pour l'image d'aperçu des liens partagés)
NEXT_PUBLIC_SITE_URL=https://ton-evenement.vercel.app

# Vitrine publique : réponses d'exemple visibles, réponses des visiteurs isolées et effacées après 2 jours, admin en lecture seule
DEMO_MODE=
